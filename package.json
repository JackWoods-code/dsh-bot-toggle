{
  "name": "dsh-bot-toggle",
  "version": "0.3.0",
  "description": "A floating Bot / ADE switch for the DSH web UI: toggles ds-bot's Bot surface and the classic DSH surface without unloading ds-bot.",
  "license": "MIT",
  "author": "JackWoods-code",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-web",
    "ds-bot",
    "bot-mode",
    "surface-switch",
    "ui"
  ],
  "homepage": "https://github.com/JackWoods-code/dsh-bot-toggle#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JackWoods-code/dsh-bot-toggle.git"
  },
  "bugs": {
    "url": "https://github.com/JackWoods-code/dsh-bot-toggle/issues"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.2": "compatible",
        "0.2.1-rc.3": "compatible"
      }
    }
  }
}
